{
  "reviewer": "your-github-username",
  "poll_interval_minutes": 5,
  "max_sessions_per_poll": 2,
  "max_concurrent_sessions": 4,
  "mention_window_hours": 24,
  "harness": "claude",
  "model": {
    "provider": "",
    "model": "opus",
    "reasoningEffort": "high"
  },
  "claude": {
    "bin": "",
    "config_dir": ""
  },
  "session_env": {
    "HTTPS_PROXY": "",
    "NO_PROXY": "",
    "SSL_CERT_FILE": ""
  },
  "gh": {
    "token_env": "",
    "token": "",
    "base_url": "https://github.com"
  },
  "custom_prompt": "Help audit the code changes, make sure it's correct, safe and secure, KISS and DRY. Please feel free to leave inline comments.",
  "git_dir": "git",
  "worktree_base": "worktrees",
  "repos": [
    {
      "repo": "org/repo-a",
      "reviewer": "reviewer-a"
    },
    {
      "repo": "org/repo-b",
      "harness": "dsh",
      "model": {
        "provider": "opencode-go",
        "model": "deepseek-v4-flash",
        "reasoningEffort": "max"
      },
      "custom_prompt": "Focus on security and error handling."
    }
  ]
}
