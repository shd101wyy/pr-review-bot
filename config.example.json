{
  "reviewer": "your-github-username",
  "poll_interval_minutes": 5,
  "max_sessions_per_poll": 2,
  "mention_window_hours": 24,
  "model": {
    "provider": "opencode-go",
    "model": "deepseek-v4-flash",
    "reasoningEffort": "max"
  },
  "gh": {
    "token_env": "",
    "base_url": "https://github.com"
  },
  "custom_prompt": "Help audit the code changes, make sure it's correct, safe and secure, KISS and DRY. Please feel free to leave inline comments.",
  "git_dir": "git",
  "worktree_base": "worktrees",
  "repos": [
    {
      "repo": "org/repo-a",
      "reviewer": "reviewer-a"
    },
    {
      "repo": "org/repo-b"
    }
  ]
}